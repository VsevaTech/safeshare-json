{
  "name": "safeshare-json",
  "version": "1.0.0",
  "private": true,
  "description": "Sanitize production JSON before sharing it with developers, QA or support - entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.5.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
