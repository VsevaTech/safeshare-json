    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^26.5.1",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
